<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="src" path="src"/>
	<classpathentry kind="src" path="resources"/>
	<classpathentry kind="con" path="org.eclipse.jdt.USER_LIBRARY/LWGJL3"/>
	<classpathentry kind="lib" path="lib/lwjgl.jar"/>
	<classpathentry kind="lib" path="lib/lwjgl-natives-windows.jar"/>
	<classpathentry kind="lib" path="lib/lwjgl-stb.jar"/>
	<classpathentry kind="lib" path="lib/lwjgl-stb-natives-windows.jar"/>
	<classpathentry kind="lib" path="lib/lwjgl-openal.jar"/>
	<classpathentry kind="lib" path="lib/lwjgl-openal-natives-windows.jar"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
